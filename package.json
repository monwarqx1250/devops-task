{
  "name": "devops-assessment-service",
  "version": "1.0.0",
  "description": "Small Fastify service for the DevOps assessment",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.8"
  },
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome@1.9.4 lint .",
    "typecheck": "bunx -p typescript@5.8.3 tsc --noEmit",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov"
  },
  "dependencies": {
    "fastify": "5.2.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.13.4"
  }
}
