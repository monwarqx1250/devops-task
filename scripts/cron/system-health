# /etc/cron.d/system-health - alternative to the systemd timer.
# Runs every 5 minutes as root; output is already written to the log file.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5 * * * * root /usr/local/bin/system_health.sh --quiet --json --log-file /var/log/system_health/health_log.txt >/dev/null 2>&1
