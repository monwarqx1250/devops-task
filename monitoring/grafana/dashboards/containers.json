    {
      "type": "stat",
      "title": "Highest memory vs limit",
      "description": "Container closest to its memory limit. Red from 90%, the ContainerMemoryNearLimit alert threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(100 * max by (name) (container_memory_working_set_bytes{name=~\"$container\", name!=\"\"}) / max by (name) (container_spec_memory_limit_bytes{name=~\"$container\", name!=\"\"} > 0))",
          "refId": "A",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
