    {
      "type": "bargauge",
      "title": "Filesystem usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Used space per disk device (a device mounted at several paths is shown once). Red from 80% (alert threshold).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device, fstype) (100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\", fstype!~\"tmpfs|ramfs|squashfs|overlay|nsfs|fuse.*|virtiofs\"} / node_filesystem_size_bytes{job=\"node-exporter\", fstype!~\"tmpfs|ramfs|squashfs|overlay|nsfs|fuse.*|virtiofs\"}))",
          "refId": "A",
          "legendFormat": "{{device}} ({{fstype}})",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
