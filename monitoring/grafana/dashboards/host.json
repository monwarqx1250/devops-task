      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_network_receive_errs_total{job=\"node-exporter\", device!~\"lo|veth.*|br-.*|docker.*|dummy.*|kiri.*|kv.*\"}[$__rate_interval]) + rate(node_network_transmit_errs_total{job=\"node-exporter\", device!~\"lo|veth.*|br-.*|docker.*|dummy.*|kiri.*|kv.*\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{device}} errors",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
